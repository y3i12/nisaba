#!/usr/bin/env python3
"""
PreCompact hook / manual transcript extractor.

Thin wrapper around nisaba.compact — kept for PreCompact hook usage
(stdin JSON with transcript_path) and explicit-path invocation.
For the common case, prefer `nisaba compact` which auto-discovers
the active session.
"""

import json
import sys
from pathlib import Path

from nisaba.compact import append_to_cache, extract_transcript


def main():
    try:
        session_file = None

        if not sys.stdin.isatty():
            try:
                hook_data = json.load(sys.stdin)
                if "transcript_path" in hook_data:
                    session_file = Path(hook_data["transcript_path"])
            except (json.JSONDecodeError, KeyError, ValueError):
                pass

        if not session_file and len(sys.argv) > 1:
            session_file = Path(sys.argv[1])

        if not session_file or not session_file.exists():
            print("No session file found - skipping transcript extraction", file=sys.stderr)
            sys.exit(1)

        session_id = session_file.stem
        transcript = extract_transcript(session_file, session_id)
        if not transcript:
            print("No transcript content extracted", file=sys.stderr)
            sys.exit(0)

        append_to_cache(transcript)
        print("Transcript saved to .nisaba/base_files/compacted_transcript.md", file=sys.stderr)
        sys.exit(0)

    except Exception as e:
        print(f"ERROR: {e}", file=sys.stderr)
        import traceback
        traceback.print_exc(file=sys.stderr)
        sys.exit(0)


if __name__ == "__main__":
    main()
